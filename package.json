{
  "name": "tunnelde-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Link-only independent plugin registry for Tunnelde",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "registry": "node scripts/validate.mjs --write",
    "registry:check": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "audit": "node scripts/audit.mjs",
    "updates": "node scripts/update.mjs"
  },
  "devDependencies": {
    "@tunnelde/plugin-sdk": "https://github.com/TunneldeDev/Tunnelde-plugin-sdk/releases/download/v1.0.1/tunnelde-plugin-sdk-1.0.1.tgz"
  }
}
