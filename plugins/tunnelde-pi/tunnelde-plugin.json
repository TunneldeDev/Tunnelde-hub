{
  "id": "tunnelde-pi",
  "name": "Pi",
  "version": "1.19.2",
  "apiVersion": 1,
  "runtime": "node",
  "main": "index.mjs",
  "author": "TunneldeDev",
  "readme": "README.md",
  "engines": {
    "node": ">=22",
    "tunnelde": ">=0.26.0"
  },
  "description": "Independent Pi RPC chat with bundled permission extension, explicit runtime selection and API review.",
  "commands": [
    {
      "id": "ai.send",
      "title": "Send Pi message"
    },
    {
      "id": "ai.stop",
      "title": "Stop Pi agent"
    },
    {
      "id": "ai.configure",
      "title": "Configure Pi providers"
    },
    {
      "id": "ai.session",
      "title": "Manage Pi conversation"
    },
    {
      "id": "ai.approve",
      "title": "Review Pi action"
    },
    {
      "id": "ai.recover",
      "title": "Inspect or recover Pi agent"
    },
    {
      "id": "ai.target",
      "title": "Select local or remote execution target"
    },
    {
      "id": "ai.prepare",
      "title": "Initialize selected agent"
    },
    {
      "id": "ai.install",
      "title": "Install and initialize remote agent"
    }
  ],
  "views": [
    {
      "id": "chat",
      "title": "Pi",
      "location": "sidebar",
      "kind": "chat",
      "icon": "message-square"
    }
  ],
  "permissions": [
    "network",
    "process.exec",
    "ssh.exec",
    "fs.read",
    "fs.write",
    "sftp.read",
    "sftp.write",
    "secrets",
    "sessions.read",
    "hosts.read"
  ]
}
