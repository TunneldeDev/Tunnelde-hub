{
  "id": "jsonl-log-viewer",
  "name": "JSONL Log Viewer",
  "version": "1.20.0",
  "apiVersion": 1,
  "runtime": "node",
  "main": "index.mjs",
  "author": "TunneldeDev",
  "readme": "README.md",
  "engines": {
    "node": ">=22",
    "tunnelde": ">=0.29.0-beta.2"
  },
  "description": "Read structured JSONL and NDJSON logs as conventional timestamped log lines, directly in the active editor.",
  "tags": [
    "logs",
    "jsonl",
    "json",
    "formatter",
    "developer-tools"
  ],
  "commands": [
    {
      "id": "to-log",
      "title": "JSONL: Convert to readable log",
      "keybindings": [
        "Mod+Shift+F"
      ],
      "editor": {
        "extensions": [
          "jsonl",
          "ndjson"
        ],
        "format": true
      }
    }
  ],
  "views": [
    {
      "id": "main",
      "title": "JSONL Log Viewer"
    }
  ],
  "permissions": [
    "editor.read",
    "editor.write"
  ]
}
