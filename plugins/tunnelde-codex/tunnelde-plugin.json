{
  "id": "tunnelde-codex",
  "name": "Codex",
  "version": "1.19.2",
  "apiVersion": 1,
  "runtime": "node",
  "main": "index.mjs",
  "author": "TunneldeDev",
  "readme": "README.md",
  "engines": {
    "node": ">=22",
    "tunnelde": ">=0.26.0"
  },
  "description": "Independent Codex app-server chat with scoped approval modes and optional durable SSH agents.",
  "commands": [
    {
      "id": "ai.send",
      "title": "Send Codex message"
    },
    {
      "id": "ai.stop",
      "title": "Stop Codex agent"
    },
    {
      "id": "ai.configure",
      "title": "Configure Codex providers"
    },
    {
      "id": "ai.session",
      "title": "Manage Codex conversation"
    },
    {
      "id": "ai.approve",
      "title": "Review Codex action"
    },
    {
      "id": "ai.recover",
      "title": "Inspect or recover Codex agent"
    },
    {
      "id": "ai.target",
      "title": "Select local or remote execution target"
    },
    {
      "id": "ai.prepare",
      "title": "Initialize selected agent"
    },
    {
      "id": "ai.install",
      "title": "Install and initialize remote agent"
    }
  ],
  "views": [
    {
      "id": "chat",
      "title": "Codex",
      "location": "sidebar",
      "kind": "chat",
      "icon": "terminal"
    }
  ],
  "permissions": [
    "network",
    "process.exec",
    "ssh.exec",
    "fs.read",
    "fs.write",
    "sftp.read",
    "sftp.write",
    "secrets",
    "sessions.read",
    "hosts.read"
  ]
}
