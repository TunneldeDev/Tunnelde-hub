{
  "id": "json-formatter",
  "name": "JSON Formatter",
  "version": "1.8.1",
  "apiVersion": 1,
  "runtime": "node",
  "main": "index.mjs",
  "author": "TunneldeDev",
  "readme": "README.md",
  "engines": {
    "node": ">=22",
    "tunnelde": ">=0.29.0-beta.2"
  },
  "description": "Format and minify JSON locally without losing numeric precision.",
  "commands": [
    {
      "id": "pretty",
      "title": "Format JSON",
      "keybindings": ["Mod+Shift+F"],
      "editor": { "extensions": ["json"], "format": true }
    },
    {
      "id": "minify",
      "title": "Minify JSON",
      "keybindings": ["Mod+Alt+M"],
      "editor": { "extensions": ["json"] }
    }
  ],
  "views": [
    {
      "id": "main",
      "title": "JSON Formatter"
    }
  ],
  "permissions": ["editor.read", "editor.write"]
}
