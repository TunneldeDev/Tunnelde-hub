{
  "id": "tunnelde-ai",
  "name": "Tunnelde AI",
  "version": "1.19.8",
  "apiVersion": 1,
  "runtime": "node",
  "main": "index.mjs",
  "author": "TunneldeDev",
  "readme": "README.md",
  "engines": {
    "node": ">=22",
    "tunnelde": ">=0.26.0"
  },
  "description": "API chat with scoped reviewed tools and optional recoverable remote assistants.",
  "commands": [
    {
      "id": "ai.send",
      "title": "Send AI message"
    },
    {
      "id": "ai.stop",
      "title": "Stop AI agent"
    },
    {
      "id": "ai.configure",
      "title": "Configure AI providers"
    },
    {
      "id": "ai.session",
      "title": "Manage AI conversation"
    },
    {
      "id": "ai.approve",
      "title": "Review AI action"
    },
    {
      "id": "ai.recover",
      "title": "Inspect or recover AI agent"
    },
    {
      "id": "ai.target",
      "title": "Select local or remote execution target"
    },
    {
      "id": "ai.prepare",
      "title": "Initialize selected agent"
    },
    {
      "id": "ai.install",
      "title": "Install and initialize remote agent"
    }
  ],
  "views": [
    {
      "id": "chat",
      "title": "Tunnelde AI",
      "location": "sidebar",
      "kind": "chat",
      "icon": "bot"
    }
  ],
  "permissions": [
    "network",
    "process.exec",
    "ssh.exec",
    "fs.read",
    "fs.write",
    "sftp.read",
    "sftp.write",
    "secrets",
    "sessions.read",
    "hosts.read"
  ]
}
