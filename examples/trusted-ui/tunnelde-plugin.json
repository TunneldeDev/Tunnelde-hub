{
  "id": "example-trusted-ui",
  "name": "Trusted UI example",
  "version": "1.0.0",
  "description": "Experimental component view using the shared host React and UI SDK",
  "author": "TunneldeDev",
  "readme": "README.md",
  "apiVersion": 1,
  "runtime": "frontend",
  "frontend": { "entry": "ui/index.mjs", "sdk": "^0.1.0" },
  "permissions": ["ui.trusted", "hosts.read", "fs.read", "sftp.read", "workspace.write"],
  "commands": [
    { "id": "hello", "title": "UI example: Hello" },
    { "id": "inspect-host", "title": "Inspect host", "hostMenu": true }
  ],
  "views": [
    { "id": "main", "title": "UI example", "kind": "component", "location": "sidebar" },
    { "id": "desktop", "title": "Navigation on the right", "kind": "component", "provider": "workbench" },
    { "id": "files", "title": "File list with summary", "kind": "component", "provider": "fileBrowser" }
  ]
}
